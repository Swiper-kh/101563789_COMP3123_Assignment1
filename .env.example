# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000

# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# The database name is always comp3123_assignment1 (set in code).
MONGODB_URI=mongodb://127.0.0.1:27017

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

BCRYPT_SALT_ROUNDS=10

# Rate limiting (per client IP)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MIN=15

LOG_LEVEL=info
